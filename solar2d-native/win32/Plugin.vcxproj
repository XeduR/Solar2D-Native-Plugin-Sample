<?xml version="1.0" encoding="utf-8"?>
<!--
  Solar2D Hello Plugin - Visual Studio Project

  This project builds the plugin using the Solar2D Native SDK.

  Prerequisites:
    - Solar2D Native SDK installed (sets CORONA_ROOT environment variable)
    - Visual Studio 2022 (or 2019 with v142 toolset)

  The CORONA_ROOT environment variable should point to:
    C:\Program Files (x86)\Corona Labs\Corona\Native

  The built DLL is automatically copied to the Solar2D Simulator plugins directory.
-->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
