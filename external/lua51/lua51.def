; lua51.def
; Lua 5.1 C API exports for generating an import library.
; Used by CI to link against Solar2D's lua.dll without the SDK.
;
; Usage: lib /def:lua51.def /out:lua51.lib /machine:x86

LIBRARY lua.dll
EXPORTS
    ; State manipulation
    lua_newstate
    lua_close
    lua_newthread
    lua_atpanic

    ; Stack operations
    lua_gettop
    lua_settop
    lua_pushvalue
    lua_remove
    lua_insert
    lua_replace
    lua_checkstack
    lua_xmove

    ; Type checks and access
    lua_isnumber
    lua_isstring
    lua_iscfunction
    lua_isuserdata
    lua_type
    lua_typename

    ; Value comparisons
    lua_equal
    lua_rawequal
    lua_lessthan

    ; Get values from stack
    lua_tonumber
    lua_tointeger
    lua_toboolean
    lua_tolstring
    lua_objlen
    lua_tocfunction
    lua_touserdata
    lua_tothread
    lua_topointer

    ; Push values onto stack
    lua_pushnil
    lua_pushnumber
    lua_pushinteger
    lua_pushlstring
    lua_pushstring
    lua_pushvfstring
    lua_pushfstring
    lua_pushcclosure
    lua_pushboolean
    lua_pushlightuserdata
    lua_pushthread

    ; Table operations
    lua_gettable
    lua_getfield
    lua_rawget
    lua_rawgeti
    lua_createtable
    lua_newuserdata
    lua_getmetatable
    lua_getfenv
    lua_settable
    lua_setfield
    lua_rawset
    lua_rawseti
    lua_setmetatable
    lua_setfenv

    ; Call and load
    lua_call
    lua_pcall
    lua_cpcall
    lua_load
    lua_dump

    ; Coroutines
    lua_yield
    lua_resume
    lua_status

    ; Garbage collection
    lua_gc

    ; Miscellaneous
    lua_error
    lua_next
    lua_concat
    lua_getallocf
    lua_setallocf

    ; Global table
    lua_getglobal_compat = lua_getfield
    lua_setglobal_compat = lua_setfield

    ; Auxiliary library (lauxlib)
    luaL_openlib
    luaL_register
    luaL_getmetafield
    luaL_callmeta
    luaL_typerror
    luaL_argerror
    luaL_checklstring
    luaL_optlstring
    luaL_checknumber
    luaL_optnumber
    luaL_checkinteger
    luaL_optinteger
    luaL_checkstack
    luaL_checktype
    luaL_checkany
    luaL_newmetatable
    luaL_checkudata
    luaL_where
    luaL_error
    luaL_ref
    luaL_unref
    luaL_loadfile
    luaL_loadbuffer
    luaL_loadstring
    luaL_newstate
    luaL_gsub
    luaL_findtable
    luaL_buffinit
    luaL_prepbuffer
    luaL_addlstring
    luaL_addstring
    luaL_addvalue
    luaL_pushresult

    ; Standard libraries
    luaopen_base
    luaopen_table
    luaopen_io
    luaopen_os
    luaopen_string
    luaopen_math
    luaopen_debug
    luaopen_package
    luaL_openlibs
